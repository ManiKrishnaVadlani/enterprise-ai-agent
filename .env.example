APP_NAME=Enterprise AI Knowledge & Workflow Agent
LOG_LEVEL=INFO
AI_MODE=local
# Blank preserves legacy selection: extractive for AI_MODE=local, OpenAI for openai.
LLM_PROVIDER=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b-q4_K_M
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_THINK=false
OLLAMA_NUM_PREDICT=512
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_PROMPT_CHARS=12000
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini
DATABASE_PATH=data/knowledge.db
LOCAL_DATABASE_PATH=data/knowledge-local.db
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
MIN_RELEVANCE_SCORE=0.15
# Optional provider-specific overrides; otherwise MIN_RELEVANCE_SCORE is used.
# Calibrate each threshold with representative questions and documents.
# LOCAL_MIN_RELEVANCE_SCORE=<calibrated value from 0 to 1>
# OPENAI_MIN_RELEVANCE_SCORE=<calibrated value from 0 to 1>
MAX_UPLOAD_BYTES=10485760
MAX_CONCURRENT_UPLOADS=2
UPLOAD_WAIT_TIMEOUT_SECONDS=5
MAX_PDF_PAGES=200
MAX_EXTRACTED_TEXT_CHARS=2000000
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
