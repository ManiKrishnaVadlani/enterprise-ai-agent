{
  "name": "enterprise-ai-agent-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.app.json && node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "dev": "node ./node_modules/vite/bin/vite.js",
    "start": "serve --single --listen $PORT dist"
  },
  "dependencies": {
    "lucide-react": "1.75.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^7.0.0",
    "serve": "^14.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
